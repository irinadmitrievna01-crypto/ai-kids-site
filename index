// Safe storage
function getKey(){try{return localStorage.getItem('ss_key')||_memKey;}catch(e){return _memKey;}}
function setKey(k){_memKey=k;try{localStorage.setItem('ss_key',k);}catch(e){}}
function getFree(){try{var v=localStorage.getItem('ss_free');return v?parseInt(v,10):_memFree;}catch(e){return _memFree;}}
function setFree(n){_memFree=n;try{localStorage.setItem('ss_free',String(n));}catch(e){}}
function canFree(){return getFree()<FREE_LIMIT;}

function updateFreeUI(){
  var left=Math.max(0,FREE_LIMIT-getFree());
  var key=getKey();
  var ct=document.getElementById('freeCountText'), badge=document.getElementById('navFreeBadge');
  if(ct) ct.textContent=left+' из '+FREE_LIMIT;
  for(var i=1;i<=3;i++){var d=document.getElementById('dot'+i);if(d)d.className='free-dot'+(i>left?' used':'');}
  if(badge){
    if(key){badge.textContent='Ключ сохранён ✓';badge.className='free-badge';}
    else if(left===0){badge.textContent='Лимит исчерпан';badge.className='free-badge empty';}
    else if(left===1){badge.textContent='1 анализ остался';badge.className='free-badge warn';}
    else{badge.textContent=left+' анализа бесплатно';badge.className='free-badge';}
  }
  var fc=document.getElementById('freeCounter');
  if(fc) fc.style.display=key?'none':'flex';
}

function updateBagUI(){
  var n=tags.length, pct=Math.min(100,Math.round(n/BAG_FREE*100));
  var c=document.getElementById('bagCount'), f=document.getElementById('bagFill');
  if(c) c.textContent=n+' из '+BAG_FREE+' (Free)';
  if(f) f.style.width=pct+'%';
}

document.addEventListener('DOMContentLoaded',function(){
  // Restore saved key
  var saved=getKey();
  if(saved) document.getElementById('apiKey').value=saved;
  updateFreeUI(); updateBagUI();

  // Save key on blur
  document.getElementById('apiKey').addEventListener('blur',function(){
    var k=this.value.trim();
    if(k.startsWith('sk-ant')) {setKey(k);updateFreeUI();}
  });

  // Multi-photo
  document.querySelectorAll('.photo-zone').forEach(function(zone){
    var inp=zone.querySelector('input[type=file]'), img=zone.querySelector('img');
    var idx=parseInt(inp.getAttribute('data-idx'));
    inp.setAttribute('accept','image/*');
    inp.addEventListener('change',function(){
      var file=this.files[0]; if(!file) return;
      var fileType=file.type||'image/jpeg';
      var rd=new FileReader();
      rd.onerror=function(){alert('Не удалось загрузить фото. Попробуйте другое.');};
      rd.onload=function(e){
        var dataUrl=e.target.result;
        function saveImage(url,type){
          images[idx]={b64:url.split(',')[1],type:type};
          img.src=url; img.style.display='block';
          zone.querySelector('.pz-icon').style.display='none';
          zone.querySelector('.pz-label').style.display='none';
          zone.classList.add('has-img');
        }
        // iOS HEIC/HEIF — конвертируем в JPEG через canvas
        if(fileType==='image/heic'||fileType==='image/heif'){
          var tmpImg=new Image();
          tmpImg.onload=function(){
            var canvas=document.createElement('canvas');
            canvas.width=tmpImg.naturalWidth; canvas.height=tmpImg.naturalHeight;
            canvas.getContext('2d').drawImage(tmpImg,0,0);
            saveImage(canvas.toDataURL('image/jpeg',0.85),'image/jpeg');
          };
          tmpImg.onerror=function(){saveImage(dataUrl,'image/jpeg');};
          tmpImg.src=dataUrl;
        } else {
          saveImage(dataUrl,fileType);
        }
      };
      rd.readAsDataURL(file);
    });
  });

  // Tags
  var ti=document.getElementById('tagInput'), tw=document.getElementById('tagsWrap');
  ti.addEventListener('keydown',function(e){
    if((e.key==='Enter'||e.key===',')&&this.value.trim()){e.preventDefault();addTag(this.value.trim().replace(/,$/,''));this.value='';}
    if(e.key==='Backspace'&&!this.value&&tags.length) removeTag(tags.length-1);
  });
  tw.addEventListener('click',function(){ti.focus();});

  document.getElementById('analyzeBtn').addEventListener('click',runAnalysis);
  document.getElementById('demoBtn').addEventListener('click',function(){
    ['The Ordinary Retinol 0.5%','The Ordinary AHA 30%','CeraVe Moisturizing Cream','Vitamin C 20%'].forEach(addTag);
  });

  document.getElementById('bagAddBtn').addEventListener('click',function(){
    if(tags.length>=BAG_FREE) openModal('proModal');
    else{document.getElementById('tagInput').focus();scrollTo('analyzerSection');}
  });

  // Procedure
  document.getElementById('procSelect').addEventListener('change',function(){selectedProc=this.value;renderProtocol();});
  document.querySelectorAll('.day-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.day-btn').forEach(function(b){b.classList.remove('active');});
      this.classList.add('active');
      selectedDay=parseInt(this.getAttribute('data-day'));
      renderProtocol();
    });
  });
});

