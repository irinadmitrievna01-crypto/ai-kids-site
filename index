<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>🤖 АИ-Академия 2.0</title>
<link rel="stylesheet" href="styles.css">
</head>
<body>

<div id="stars-display">⭐ <span id="stars-count">0</span></div>
<button id="parent-btn">👨‍👩‍👧 Родителям</button>
<div class="confetti-container" id="confetti-container"></div>

<!-- ===================== ГЛАВНАЯ ===================== -->
<div id="page-home" class="page active">
  <div class="home-hero">
    <div class="robot-emoji">🤖</div>
    <h1 class="home-title">АИ-Академия 2.0</h1>
    <p class="home-subtitle">Учимся искусственному интеллекту, языкам и программированию! Выбери направление:</p>
  </div>

  <div class="age-cards">
    <div class="age-card age-card-4" data-page="4">
      <span class="age-number">4</span>
      <span class="age-label">года</span>
      <p class="age-desc">Игры, рисование и сказки!</p>
      <ul class="age-features">
        <li>🎤 Говори с роботом</li>
        <li>🎨 Рисуй с эффектами</li>
        <li>✨ Оживи рисунок</li>
        <li>📖 Слушай сказки</li>
      </ul>
    </div>

    <div class="age-card age-card-7" data-page="7">
      <span class="age-number">7</span>
      <span class="age-label">лет</span>
      <p class="age-desc">Программируй и создавай ИИ!</p>
      <ul class="age-features">
        <li>🎮 Создай свою игру</li>
        <li>🤖 Построй чат-бота</li>
        <li>✨ Придумай промпты</li>
        <li>🚀 Полноценные игры</li>
      </ul>
    </div>

    <div class="age-card age-card-lang" data-page="lang">
      <span class="age-number">🌍</span>
      <span class="age-label">Языки</span>
      <p class="age-desc">Английский и китайский!</p>
      <ul class="age-features">
        <li>🇬🇧 Английский</li>
        <li>🇨🇳 Китайский (中文)</li>
        <li>🗣️ Произношение</li>
        <li>🎯 Игры-слова</li>
      </ul>
    </div>
  </div>

  <div class="progress-panel" style="max-width:600px; margin-top:8px;">
    <h3>📊 Твой прогресс</h3>
    <div class="progress-modules" id="home-progress-list"></div>
  </div>
</div>

<!-- ===================== СТРАНИЦА 4 ГОДА ===================== -->
<div id="page-4" class="page">
  <div class="page-header" style="width:100%; max-width:1000px;">
    <button class="back-btn" data-back="home">← Назад</button>
    <h2 style="background:linear-gradient(90deg,#F97316,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
      🎈 Для маленьких исследователей
    </h2>
  </div>

  <div class="modules-grid" style="max-width:1000px; width:100%;">
    <!-- Голосовой помощник -->
    <div class="card voice-module">
      <div class="module-header">
        <h3>🎤 Говорилка-роботилка</h3>
        <span class="tag" style="background:rgba(124,58,237,0.3); color:var(--violet-light);">Голос</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.9rem; margin-bottom:8px;">
        Нажми на микрофон и скажи что-нибудь! Робот ответит тебе!
      </p>
      
      <button class="mic-btn" id="mic-btn" title="Говори сюда!">🎤</button>
      <p id="mic-status" style="font-size:0.85rem; color:var(--text-dim);">Нажми, чтобы говорить</p>
      
      <div class="voice-output" id="voice-output">
        👋 Привет! Я робот Бипик! Нажми на микрофон и поговори со мной!
      </div>

      <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap; justify-content:center;">
        <button class="btn btn-violet btn-sm robot-say" data-text="Привет! Я так рад тебя слышать! 🤖">Привет!</button>
        <button class="btn btn-orange btn-sm robot-say" data-text="Расскажи мне что-нибудь интересное! 🌟">Расскажи!</button>
        <button class="btn btn-teal btn-sm" id="speak-random">Случайное 🎲</button>
      </div>
    </div>

    <!-- Улучшенная рисовалка -->
    <div class="card draw-module">
      <div class="module-header">
        <h3>🎨 Умная рисовалка</h3>
        <span class="tag" style="background:rgba(249,115,22,0.3); color:var(--orange);">ИИ-фильтры</span>
      </div>
      
      <div class="color-picker-row" id="color-picker-row"></div>

      <div class="brush-size-row">
        <span style="font-size:0.8rem; color:var(--text-dim);">Кисть:</span>
        <div class="brush-dot active" style="width:12px;height:12px;" data-size="4"></div>
        <div class="brush-dot" style="width:20px;height:20px;" data-size="10"></div>
        <div class="brush-dot" style="width:28px;height:28px;" data-size="20"></div>
        <div class="brush-dot" style="width:36px;height:36px;" data-size="35"></div>
      </div>

      <canvas id="draw-canvas" width="600" height="300" style="margin-top:12px;"></canvas>
      
      <div class="filter-btns">
        <button class="btn btn-violet btn-sm filter-btn" data-filter="rainbow">🌈 Радуга</button>
        <button class="btn btn-orange btn-sm filter-btn" data-filter="starry">⭐ Звёзды</button>
        <button class="btn btn-teal btn-sm filter-btn" data-filter="glow">✨ Блеск</button>
        <button class="btn btn-pink btn-sm filter-btn" data-filter="mirror">🪞 Зеркало</button>
        <button class="btn btn-blue btn-sm filter-btn" data-filter="pixel">👾 Пиксели</button>
      </div>
      
      <div style="display:flex; gap:8px; margin-top:10px; justify-content:center; flex-wrap:wrap;">
        <button class="btn btn-sm" id="clear-canvas" style="background:rgba(255,255,255,0.1);">🗑️ Очистить</button>
        <button class="btn btn-teal btn-sm" id="download-canvas">💾 Сохранить</button>
        <button class="btn btn-yellow btn-sm award-star" data-module="Рисунок">⭐ Готово!</button>
      </div>
    </div>

    <!-- Оживление рисунков -->
    <div class="card animate-module">
      <div class="module-header">
        <h3>✨ Оживи рисунок!</h3>
        <span class="tag" style="background:rgba(236,72,153,0.3); color:var(--pink);">AI-анимация</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.9rem; margin-bottom:8px;">
        Нарисуй персонажа и посмотри, как он оживёт!
      </p>

      <div class="animation-preview" id="animation-preview">
        <span id="animated-sprite" style="font-size:4rem; transition: all 0.3s;">🐱</span>
      </div>

      <div class="animate-controls">
        <button class="btn btn-pink btn-sm animate-btn" data-anim="dance">💃 Танец</button>
        <button class="btn btn-violet btn-sm animate-btn" data-anim="jump">⬆️ Прыжки</button>
        <button class="btn btn-teal btn-sm animate-btn" data-anim="walk">🚶 Ходьба</button>
        <button class="btn btn-orange btn-sm animate-btn" data-anim="spin">🔄 Круги</button>
        <button class="btn btn-yellow btn-sm animate-btn" data-anim="wiggle">〰️ Виляние</button>
      </div>

      <div style="margin-top:12px; padding:12px; background:rgba(0,0,0,0.2); border-radius:12px; font-size:0.85rem; color:var(--text-dim);">
        💡 <strong>Совет:</strong> Нарисуй персонажа с головой, руками и ногами — так анимация будет лучше!
      </div>

      <button class="btn btn-pink award-star" data-module="Анимация" style="margin-top:12px; width:100%;">
        ⭐ Мой персонаж ожил!
      </button>
    </div>

    <!-- Перетаскивание -->
    <div class="card drag-module">
      <div class="module-header">
        <h3>🧩 Кто где живёт?</h3>
        <span class="tag" style="background:rgba(13,148,136,0.3); color:var(--teal-light);">Игра</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.9rem; margin-bottom:8px;">
        Перетащи животных в правильные домики!
      </p>

      <div class="drag-area" id="drag-source">
        <div class="drag-item" draggable="true" data-animal="fish" data-home="water" id="drag-fish">🐟</div>
        <div class="drag-item" draggable="true" data-animal="bird" data-home="sky" id="drag-bird">🐦</div>
        <div class="drag-item" draggable="true" data-animal="bear" data-home="forest" id="drag-bear">🐻</div>
        <div class="drag-item" draggable="true" data-animal="frog" data-home="water" id="drag-frog">🐸</div>
      </div>

      <div class="drop-zones">
        <div class="drop-zone" id="zone-water" data-zone="water">
          🌊<span class="zone-label">Вода</span>
        </div>
        <div class="drop-zone" id="zone-sky" data-zone="sky">
          ☁️<span class="zone-label">Небо</span>
        </div>
        <div class="drop-zone" id="zone-forest" data-zone="forest">
          🌲<span class="zone-label">Лес</span>
        </div>
      </div>

      <div id="drag-feedback" style="text-align:center; margin-top:12px; font-size:1rem; min-height:24px;"></div>
      <button class="btn btn-orange btn-sm" id="reset-drag" style="margin-top:8px; width:100%;">🔄 Заново</button>
    </div>

    <!-- Сказки -->
    <div class="card story-module">
      <div class="module-header">
        <h3>📖 Сказочный ИИ</h3>
        <span class="tag" style="background:rgba(236,72,153,0.3); color:var(--pink);">Сказки</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.9rem; margin-bottom:8px;">
        Выбери героя и место — ИИ придумает сказку!
      </p>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
        <div>
          <label style="font-size:0.82rem; color:var(--text-dim); display:block; margin-bottom:5px; font-weight:600;">Главный герой:</label>
          <select id="story-hero" style="width:100%;background:rgba(0,0,0,0.3);border:2px solid rgba(255,255,255,0.1);border-radius:12px;padding:10px;color:var(--text);font-family:inherit;font-size:0.9rem;">
            <option value="dragon">🐉 Дракончик</option>
            <option value="robot">🤖 Роботик</option>
            <option value="unicorn">🦄 Единорог</option>
            <option value="bunny">🐰 Зайчик</option>
            <option value="star">⭐ Звёздочка</option>
          </select>
        </div>
        <div>
          <label style="font-size:0.82rem; color:var(--text-dim); display:block; margin-bottom:5px; font-weight:600;">Место:</label>
          <select id="story-place" style="width:100%;background:rgba(0,0,0,0.3);border:2px solid rgba(255,255,255,0.1);border-radius:12px;padding:10px;color:var(--text);font-family:inherit;font-size:0.9rem;">
            <option value="forest">🌲 Волшебный лес</option>
            <option value="space">🚀 Космос</option>
            <option value="ocean">🌊 Подводный мир</option>
            <option value="castle">🏰 Замок</option>
            <option value="cloud">☁️ Облачный город</option>
          </select>
        </div>
      </div>

      <div class="story-output" id="story-output">
        Нажми кнопку и я расскажу тебе сказку! ✨
      </div>

      <div class="story-controls">
        <button class="btn btn-pink" id="generate-story" style="flex:1; min-width:130px;">✨ Новая сказка!</button>
        <button class="btn btn-teal btn-sm" id="read-story" title="Послушать сказку">🔊 Читать</button>
        <button class="btn btn-sm" id="download-story" style="background:rgba(255,255,255,0.1);">💾</button>
      </div>
    </div>
  </div>
</div>

<!-- ===================== СТРАНИЦА 7 ЛЕТ ===================== -->
<div id="page-7" class="page">
  <div class="page-header" style="width:100%; max-width:1100px;">
    <button class="back-btn" data-back="home">← Назад</button>
    <h2 style="background:linear-gradient(90deg,#0D9488,#7C3AED);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
      🚀 Лаборатория юного программиста
    </h2>
  </div>

  <div class="modules-grid" style="max-width:1100px; width:100%;">
    <!-- Улучшенный конструктор игр -->
    <div class="card game-builder" style="grid-column: 1 / -1;">
      <div class="module-header">
        <h3>🎮 Конструктор игр PRO</h3>
        <span class="tag" style="background:rgba(124,58,237,0.3);color:var(--violet-light);">Блоки</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.88rem; margin-bottom:12px;">
        Создай полноценную игру! Перетащи блоки, настрой уровень и играй!
      </p>

      <div class="blocks-palette" id="blocks-palette">
        <div class="code-block event" data-block="when_click">▶ Нажали</div>
        <div class="code-block action" data-block="move_right">→ Вправо</div>
        <div class="code-block action" data-block="move_left">← Влево</div>
        <div class="code-block action" data-block="jump">⬆ Прыжок</div>
        <div class="code-block action" data-block="move_up">⬆️ Вверх</div>
        <div class="code-block action" data-block="move_down">⬇️ Вниз</div>
        <div class="code-block control" data-block="repeat">🔁 Повторить</div>
        <div class="code-block control" data-block="if_coin">💰 Если монета</div>
        <div class="code-block sound" data-block="play_sound">🔊 Звук</div>
        <div class="code-block look" data-block="change_color">🎨 Цвет</div>
        <div class="code-block look" data-block="spin">🔄 Крутить</div>
        <div class="code-block look" data-block="grow">📏 Расти</div>
      </div>

      <div class="code-canvas" id="code-canvas">
        <p style="color:var(--text-dim); font-size:0.85rem; pointer-events:none;" id="canvas-placeholder">
          Нажми на блоки сверху, чтобы добавить их в программу ↑
        </p>
      </div>

      <!-- Игровой движок -->
      <div class="game-canvas-container" id="game-container">
        <div class="game-score">⭐ <span id="game-score">0</span></div>
        <div class="game-player" id="game-player" style="left: 50px; top: 210px;">🐱</div>
        <div class="game-coin" id="coin1" style="left: 150px; top: 150px;">🪙</div>
        <div class="game-coin" id="coin2" style="left: 300px; top: 100px;">🪙</div>
        <div class="game-obstacle" style="left: 200px; top: 240px; width: 60px; height: 20px; background: #8B4513;"></div>
        <div class="game-obstacle" style="left: 400px; top: 200px; width: 40px; height: 40px; background: #666;"></div>
      </div>

      <div class="game-controls">
        <button class="btn btn-violet btn-sm" id="run-game" style="flex:1;">▶ Запустить игру!</button>
        <button class="btn btn-sm" id="clear-blocks" style="background:rgba(255,255,255,0.1); flex:1;">🗑 Очистить код</button>
        <button class="btn btn-teal btn-sm" id="reset-game" style="flex:1;">🔄 Новая игра</button>
        <button class="btn btn-yellow btn-sm" id="export-game" style="flex:1;">💾 Экспорт</button>
      </div>

      <div style="margin-top:12px; padding:12px; background:rgba(0,0,0,0.2); border-radius:12px; font-size:0.85rem; color:var(--text-dim);">
        💡 <strong>Как играть:</strong> Собери монеты 🪙, избегая препятствий! Используй блоки движения и прыжков.
      </div>
    </div>

    <!-- Чат-бот -->
    <div class="card chatbot-module">
      <div class="module-header">
        <h3>🤖 Сделай своего бота!</h3>
        <span class="tag" style="background:rgba(13,148,136,0.3);color:var(--teal-light);">Чат-бот</span>
      </div>

      <div class="bot-config">
        <label>Имя бота:</label>
        <input type="text" id="bot-name" value="Бипик" maxlength="20">
      </div>
      <div class="bot-config">
        <label>Добавь ответ на вопрос:</label>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
          <input type="text" id="bot-trigger" placeholder='Если спросят "привет"...'>
          <input type="text" id="bot-response" placeholder='Ответить "Привет! 👋"'>
        </div>
        <button class="btn btn-teal btn-sm" id="add-bot-rule" style="margin-top:8px;">+ Добавить правило</button>
      </div>

      <div id="bot-rules" style="font-size:0.82rem; color:var(--text-dim); margin-bottom:8px; max-height:70px; overflow-y:auto;"></div>

      <div class="chat-window" id="chat-window"></div>

      <div class="chat-input-row">
        <input type="text" id="chat-input" placeholder="Напиши что-нибудь боту...">
        <button class="btn btn-teal btn-sm" id="send-chat">📨</button>
      </div>

      <button class="btn btn-yellow btn-sm award-star" data-module="Чат-бот" style="margin-top:8px; width:100%;">
        ⭐ Мой бот готов!
      </button>
    </div>

    <!-- Промпты -->
    <div class="card prompt-module">
      <div class="module-header">
        <h3>✨ Генератор промптов</h3>
        <span class="tag" style="background:rgba(249,115,22,0.3);color:var(--orange);">ИИ-текст</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.88rem; margin-bottom:12px;">
        Промпт — это задание для ИИ! Собери свой промпт:
      </p>

      <div class="prompt-options">
        <div class="prompt-select-group">
          <label>Кто? (герой)</label>
          <select id="p-who">
            <option value="робот-исследователь">🤖 Робот-исследователь</option>
            <option value="добрый дракон">🐉 Добрый дракон</option>
            <option value="маленькая волшебница">🧙‍♀️ Волшебница</option>
            <option value="космонавт-кот">🐱 Кот-космонавт</option>
            <option value="подводная фея">🧜 Подводная фея</option>
            <option value="говорящий медвежонок">🐻 Медвежонок</option>
          </select>
        </div>
        <div class="prompt-select-group">
          <label>Где? (место)</label>
          <select id="p-where">
            <option value="в радужном облаке">🌈 Радужное облако</option>
            <option value="на далёкой планете">🪐 Далёкая планета</option>
            <option value="в подводном дворце">🏰 Подводный дворец</option>
            <option value="в светящемся лесу">✨ Светящийся лес</option>
            <option value="на летающем острове">🏝 Летающий остров</option>
            <option value="в городе будущего">🌆 Город будущего</option>
          </select>
        </div>
        <div class="prompt-select-group">
          <label>Что делает?</label>
          <select id="p-action">
            <option value="открывает тайную дверь">🚪 Открывает дверь</option>
            <option value="летит к звёздам">🌟 Летит к звёздам</option>
            <option value="делает магию">🪄 Делает магию</option>
            <option value="ищет сокровища">💎 Ищет сокровища</option>
            <option value="строит машину">⚙️ Строит машину</option>
            <option value="играет в игры">🎮 Играет</option>
          </select>
        </div>
        <div class="prompt-select-group">
          <label>Стиль картинки</label>
          <select id="p-style">
            <option value="мультфильм Pixar">🎬 Мультик Pixar</option>
            <option value="акварельная иллюстрация">🖌 Акварель</option>
            <option value="детская книжная иллюстрация">📚 Книжка</option>
            <option value="яркое аниме">🇯🇵 Аниме</option>
            <option value="3D-рендер">💻 3D</option>
            <option value="рисунок карандашом">✏️ Карандаш</option>
          </select>
        </div>
      </div>

      <button class="btn btn-orange" id="generate-prompt" style="width:100%;">🎲 Создать промпт!</button>

      <div class="prompt-result" id="prompt-result">
        Нажми кнопку, чтобы придумать промпт для ИИ-картинки! ✨
      </div>

      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <button class="btn btn-sm" id="copy-prompt" style="background:rgba(255,255,255,0.1); flex:1;">📋 Копировать</button>
        <button class="btn btn-yellow btn-sm award-star" data-module="Промпт" style="flex:1;">⭐ Отлично!</button>
      </div>
    </div>

    <!-- Мини-проекты -->
    <div class="card projects-module">
      <div class="module-header">
        <h3>🚀 Мини-проекты</h3>
        <span class="tag" style="background:rgba(251,191,36,0.3);color:var(--yellow);">Пошагово</span>
      </div>
      <p style="color:var(--text-dim); font-size:0.88rem; margin-bottom:4px;">
