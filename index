<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkinSync — Умный уход за кожей</title>
<meta name="description" content="ИИ анализирует вашу косметику: конфликты ингредиентов, ритуал ухода, восстановление после процедур">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{--ivory:#FAF7F2;--warm:#F3EDE3;--gold:#B8965A;--ink:#1C1916;--muted:#8C836F;--border:#E8E0D0;--danger:#9B3A2F;--warn:#A0743A;--ok:#3A6E50}
html{scroll-behavior:smooth}
body{font-family:'Jost',sans-serif;background:var(--ivory);color:var(--ink);font-weight:300;line-height:1.6;-webkit-font-smoothing:antialiased}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0 60px;height:64px;display:flex;align-items:center;justify-content:space-between;background:var(--ivory);border-bottom:1px solid var(--border)}
.nav-brand{font-family:'Playfair Display',serif;font-size:22px;font-weight:400;color:var(--ink);text-decoration:none}
.nav-brand span{color:var(--gold);font-style:italic}
.nav-links{display:flex;gap:36px}
.nav-links a{font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color .2s}
.nav-links a:hover{color:var(--ink)}
.nav-cta{font-size:12px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold);background:none;border:none;cursor:pointer;transition:opacity .2s}
.nav-cta:hover{opacity:.7}
.free-badge{font-size:11px;font-weight:500;letter-spacing:1px;color:var(--ok);border:1px solid var(--ok);padding:4px 12px}
.free-badge.warn{color:var(--warn);border-color:var(--warn)}
.free-badge.empty{color:var(--danger);border-color:var(--danger)}

/* HERO */
.hero{min-height:100vh;padding-top:64px;display:flex;flex-direction:column}
.hero-inner{flex:1;display:grid;grid-template-columns:1fr 1fr;max-width:1200px;margin:0 auto;width:100%;padding:0 60px;align-items:center;gap:80px;min-height:calc(100vh - 64px)}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:28px}
.hero-eyebrow::before{content:'';width:28px;height:1px;background:var(--gold)}
h1{font-family:'Playfair Display',serif;font-size:clamp(44px,5.5vw,72px);font-weight:400;line-height:1.08;letter-spacing:-.5px;margin-bottom:24px}
h1 em{font-style:italic;color:var(--gold)}
.hero-sub{font-size:16px;color:var(--muted);line-height:1.75;max-width:400px;margin-bottom:44px}
.hero-free-note{display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--ok);margin-bottom:32px}
.hero-free-note::before{content:'✓'}
.hero-actions{display:flex;gap:16px;align-items:center}
.btn{display:inline-flex;align-items:center;gap:8px;font-family:'Jost',sans-serif;font-size:12px;font-weight:500;letter-spacing:2px;text-transform:uppercase;cursor:pointer;border:none;transition:all .25s;text-decoration:none}
.btn-dark{background:var(--ink);color:var(--ivory);padding:16px 32px}
.btn-dark:hover{background:var(--gold);transform:translateY(-2px)}
.btn-ghost{background:transparent;color:var(--muted);padding:16px 0;border-bottom:1px solid var(--border)}
.btn-ghost:hover{color:var(--ink);border-color:var(--ink)}

/* Hero floating */
.hero-right{position:relative;height:480px;display:flex;align-items:center;justify-content:center}
.hero-bg-circle{position:absolute;width:380px;height:380px;border-radius:50%;background:var(--warm);border:1px solid var(--border)}
.floating-card{position:absolute;background:white;border:1px solid var(--border);padding:14px 20px;font-size:13px;display:flex;align-items:center;gap:10px;box-shadow:0 8px 32px rgba(28,25,22,.06);white-space:nowrap}
.fc-1{top:60px;left:0;animation:float 4s ease-in-out infinite}
.fc-2{top:130px;right:-20px;animation:float 4s ease-in-out .8s infinite}
.fc-3{bottom:130px;left:10px;animation:float 4s ease-in-out 1.6s infinite}
.fc-danger{position:absolute;bottom:75px;right:0;background:#FBF2F1;border:1px solid #E8C8C4;padding:12px 18px;font-size:12px;color:var(--danger);font-weight:500;display:flex;align-items:center;gap:8px;animation:float 4s ease-in-out .4s infinite}
.fc-ok-card{position:absolute;top:50%;left:-10px;background:#F1F8F4;border:1px solid #C0DDCA;padding:12px 18px;font-size:12px;color:var(--ok);font-weight:500;display:flex;align-items:center;gap:8px;animation:floatMid 4s ease-in-out 1.2s infinite}
.fc-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes floatMid{0%,100%{transform:translateY(-50%)}50%{transform:translateY(calc(-50% - 8px))}}

/* MARQUEE */
.marquee-wrap{border-top:1px solid var(--border);border-bottom:1px solid var(--border);overflow:hidden;padding:14px 0;background:var(--warm)}
.marquee-track{display:flex;animation:marquee 30s linear infinite;width:max-content}
.marquee-item{font-size:11px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--muted);padding:0 40px;display:flex;align-items:center;gap:40px}
.marquee-item::after{content:'✦';color:var(--gold);font-size:8px}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* STATS */
.stats{padding:80px 60px;max-width:1200px;margin:0 auto}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border)}
.stat-item{background:var(--ivory);padding:40px 32px}
.stat-num{font-family:'Playfair Display',serif;font-size:48px;font-weight:400;line-height:1;margin-bottom:8px}
.stat-lbl{font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--muted)}

/* ANALYZER */
.analyzer-section{padding:100px 60px;max-width:1200px;margin:0 auto}
.section-eyebrow{font-size:11px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:12px;margin-bottom:20px}
.section-eyebrow::before{content:'';width:24px;height:1px;background:var(--gold)}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(32px,4vw,52px);font-weight:400;line-height:1.1;margin-bottom:60px}
.section-title em{font-style:italic;color:var(--gold)}
.analyzer-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--border)}
.input-col{padding:52px;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:22px}
.result-col{padding:52px;overflow-y:auto;max-height:900px;display:flex;flex-direction:column;gap:28px}
.col-title{font-family:'Playfair Display',serif;font-size:24px;font-weight:400}

/* API KEY */
.api-row{display:flex;flex-direction:column;gap:6px}
.api-lbl{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);font-weight:500}
.api-inp{border:1px solid var(--border);background:var(--warm);padding:10px 14px;font-family:monospace;font-size:12px;color:var(--ink);outline:none;transition:border-color .2s;width:100%}
.api-inp:focus{border-color:var(--gold)}
.api-hint{font-size:10px;color:var(--muted)}
.api-hint a{color:var(--gold)}

/* FREE COUNTER */
.free-counter{display:flex;align-items:center;justify-content:space-between;background:var(--warm);border:1px solid var(--border);padding:10px 14px}
.free-counter-left{font-size:12px;color:var(--muted)}
.free-counter-left strong{color:var(--ink);font-weight:500}
.free-dots{display:flex;gap:5px}
.free-dot{width:10px;height:10px;border-radius:50%;background:var(--ok)}
.free-dot.used{background:var(--border)}

/* MULTI-PHOTO */
.photo-zones-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.photo-zone-wrap{display:flex;flex-direction:column;gap:5px}
.photo-zone-label{font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);text-align:center}
.photo-zone{position:relative;border:1px solid var(--border);background:var(--warm);min-height:100px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;text-align:center;padding:14px 8px;cursor:pointer;transition:border-color .2s,box-shadow .2s;overflow:hidden}
.photo-zone:hover{border-color:var(--gold);box-shadow:0 4px 14px rgba(184,150,90,.12)}
.photo-zone.has-img{padding:0;border-color:var(--gold)}
.photo-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;z-index:10;width:100%;height:100%}
.photo-zone img{width:100%;height:100px;object-fit:cover;display:block}
.pz-icon{font-size:20px;pointer-events:none}
.pz-label{font-size:10px;color:var(--muted);pointer-events:none;line-height:1.4}
.pz-label strong{color:var(--ink);font-weight:500;display:block}
.pz-check{position:absolute;top:5px;right:5px;background:var(--ok);color:white;width:16px;height:16px;border-radius:50%;display:none;align-items:center;justify-content:center;font-size:9px;pointer-events:none}
.photo-zone.has-img .pz-check{display:flex}

/* 3D SHELF */
.shelf-viz{display:none;border:1px solid var(--border);background:var(--warm);padding:20px}
.shelf-viz.active{display:block}
.shelf-title{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.shelf-scene{perspective:500px;height:110px;display:flex;align-items:flex-end;justify-content:center;gap:6px;padding-bottom:8px;position:relative}
.shelf-plank{position:absolute;bottom:0;left:5%;width:90%;height:5px;background:var(--border);border-radius:2px;transform:rotateX(45deg) translateZ(-5px)}
.jar{position:relative;cursor:pointer;animation:jarIn .4s ease both;transition:transform .2s}
.jar:hover{transform:translateY(-8px) scale(1.1);z-index:10}
.jar-lid{width:32px;height:7px;border-radius:3px 3px 0 0;margin-bottom:-1px}
.jar-body{width:32px;height:44px;border-radius:3px 3px 2px 2px;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 4px 10px rgba(28,25,22,.12)}
.jar.ok .jar-body{background:#D4EDDA;border:1px solid #A8D5B5}.jar.ok .jar-lid{background:#3A6E50}
.jar.warn .jar-body{background:#FEF3CD;border:1px solid #F5D57A}.jar.warn .jar-lid{background:#A0743A}
.jar.danger .jar-body{background:#F8D7DA;border:1px solid #E8A4A0}.jar.danger .jar-lid{background:#9B3A2F}
.jar-tooltip{position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--ink);color:var(--ivory);padding:7px 10px;font-size:10px;pointer-events:none;opacity:0;transition:opacity .2s;z-index:20;white-space:nowrap;max-width:160px;white-space:normal;text-align:center;line-height:1.5}
.jar:hover .jar-tooltip{opacity:1}
@keyframes jarIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* TAGS */
.or-divider{display:flex;align-items:center;gap:14px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--border)}
.or-divider::before,.or-divider::after{content:'';flex:1;height:1px;background:var(--border)}
.tags-field{border:1px solid var(--border);background:var(--warm);padding:10px 14px;min-height:76px;display:flex;flex-wrap:wrap;gap:7px;align-items:flex-start;cursor:text;transition:border-color .2s}
.tags-field:focus-within{border-color:var(--gold)}
.tag{background:white;border:1px solid var(--border);padding:3px 10px;font-size:11px;display:flex;align-items:center;gap:5px}
.tag-x{cursor:pointer;opacity:.4;font-size:13px;line-height:1}.tag-x:hover{opacity:1}
#tagInput{border:none;outline:none;background:transparent;font-family:'Jost',sans-serif;font-size:12px;font-weight:300;min-width:140px;flex:1;color:var(--ink)}
#tagInput::placeholder{color:var(--muted)}
.field-hint{font-size:10px;color:var(--muted)}

/* COSMETIC BAG */
.bag-block{background:var(--warm);border:1px solid var(--border);padding:14px 18px}
.bag-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.bag-title{font-size:11px;font-weight:500;letter-spacing:1px;text-transform:uppercase;color:var(--ink)}
.bag-count{font-size:10px;color:var(--muted)}
.bag-progress{height:3px;background:var(--border);border-radius:2px;margin-bottom:10px;overflow:hidden}
.bag-progress-fill{height:100%;background:var(--gold);border-radius:2px;transition:width .5s ease}
.bag-add-btn{background:none;border:1px solid var(--border);padding:7px 14px;font-family:'Jost',sans-serif;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);cursor:pointer;transition:all .2s;width:100%}
.bag-add-btn:hover{border-color:var(--gold);color:var(--gold)}

/* ANALYZE BTN */
.analyze-btn{background:var(--ink);color:var(--ivory);border:none;padding:17px 28px;font-family:'Jost',sans-serif;font-size:12px;font-weight:500;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:background .25s,transform .2s;display:flex;align-items:center;justify-content:center;gap:10px;width:100%}
.analyze-btn:hover:not(:disabled){background:var(--gold);transform:translateY(-2px)}
.analyze-btn:disabled{opacity:.4;cursor:not-allowed}
.spinner{width:15px;height:15px;border:1.5px solid rgba(250,247,242,.3);border-top-color:var(--ivory);border-radius:50%;animation:spin .7s linear infinite;display:none}
@keyframes spin{to{transform:rotate(360deg)}}
.demo-link{background:none;border:none;font-family:'Jost',sans-serif;font-size:11px;color:var(--muted);cursor:pointer;text-align:center;transition:color .2s;width:100%}
.demo-link:hover{color:var(--gold)}

/* MODALS */
.modal-overlay{position:fixed;inset:0;background:rgba(28,25,22,.6);backdrop-filter:blur(4px);z-index:200;display:none;align-items:center;justify-content:center;padding:24px}
.modal-overlay.active{display:flex}
.modal{background:var(--ivory);border:1px solid var(--border);max-width:460px;width:100%;padding:48px 44px;position:relative;animation:modalIn .25s ease}
@keyframes modalIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.modal-close{position:absolute;top:18px;right:18px;background:none;border:none;font-size:22px;cursor:pointer;color:var(--muted);transition:color .2s}
.modal-close:hover{color:var(--ink)}
.modal-eyebrow{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:14px}
.modal-title{font-family:'Playfair Display',serif;font-size:26px;font-weight:400;line-height:1.2;margin-bottom:10px}
.modal-sub{font-size:13px;color:var(--muted);line-height:1.7;margin-bottom:24px}
.modal-submit{background:var(--ink);color:var(--ivory);border:none;padding:15px;font-family:'Jost',sans-serif;font-size:12px;font-weight:500;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:background .25s,transform .2s;width:100%;margin-top:10px}
.modal-submit:hover{background:var(--gold);transform:translateY(-1px)}
.modal-divider{display:flex;align-items:center;gap:12px;font-size:10px;color:var(--border);letter-spacing:1px;text-transform:uppercase;margin:14px 0}
.modal-divider::before,.modal-divider::after{content:'';flex:1;height:1px;background:var(--border)}
.pro-plans{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}
.pro-plan{border:1px solid var(--border);padding:14px;cursor:pointer;transition:all .2s;text-align:center}
.pro-plan:hover,.pro-plan.selected{border-color:var(--gold);background:var(--warm)}
.pro-plan-price{font-family:'Playfair Display',serif;font-size:22px;margin-bottom:3px}
.pro-plan-desc{font-size:10px;color:var(--muted)}
.spec-input{border:1px solid var(--border);background:var(--warm);padding:11px 14px;font-family:'Jost',sans-serif;font-size:13px;color:var(--ink);outline:none;transition:border-color .2s;width:100%;margin-bottom:10px}
.spec-input:focus{border-color:var(--gold)}

/* RESULTS */
.result-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;opacity:.3;gap:12px;min-height:280px}
.result-empty-mark{font-family:'Playfair Display',serif;font-size:52px;color:var(--gold)}
.score-block{text-align:center;padding-bottom:26px;border-bottom:1px solid var(--border)}
.score-ring-wrap{position:relative;width:110px;height:110px;margin:0 auto 12px}
.score-ring-wrap svg{transform:rotate(-90deg)}
.ring-bg{fill:none;stroke:var(--border);stroke-width:6}
.ring-fill{fill:none;stroke-width:6;stroke-linecap:round;transition:stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1)}
.score-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:32px;font-weight:400}
.score-lbl{font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px}
.score-summary{font-size:13px;color:var(--muted);line-height:1.7;max-width:300px;margin:0 auto}
.result-block{border-bottom:1px solid var(--border);padding-bottom:22px}
.block-title{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.block-title::before{content:'';width:14px;height:1px;background:var(--gold)}
.conflict-list{display:flex;flex-direction:column;gap:8px}
.conflict-item{padding:12px 16px;font-size:12px}
.conflict-item.danger{background:#FBF2F1;border-left:2px solid var(--danger)}
.conflict-item.warn{background:#FBF7F0;border-left:2px solid var(--warn)}
.conflict-item.ok{background:#F1F8F4;border-left:2px solid var(--ok)}
.c-title{font-weight:500;font-size:11px;margin-bottom:2px}
.conflict-item.danger .c-title{color:var(--danger)}
.conflict-item.warn .c-title{color:var(--warn)}
.conflict-item.ok .c-title{color:var(--ok)}
.c-exp{color:var(--muted);font-size:11px;line-height:1.6}
.routine-cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.r-col-lbl{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.r-item{display:flex;gap:9px;padding:8px 0;border-bottom:1px solid var(--border)}
.r-num{width:20px;height:20px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:500;flex-shrink:0;color:var(--gold)}
.r-prod{font-weight:500;font-size:11px;margin-bottom:2px}
.r-tip{color:var(--muted);font-size:10px;line-height:1.5}
.tips-list{display:flex;flex-direction:column;gap:8px}
.tip-item{display:flex;gap:10px;font-size:12px;color:var(--muted);line-height:1.6}
.share-row{display:flex;gap:8px}
.share-btn{flex:1;border:1px solid var(--border);background:var(--warm);padding:11px;font-size:10px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;color:var(--muted);font-family:'Jost',sans-serif;transition:all .2s}
.share-btn:hover{border-color:var(--gold);color:var(--gold)}
.err-box{background:#FBF2F1;border-left:2px solid var(--danger);padding:14px 18px;font-size:12px;color:var(--danger);line-height:1.7}
.recognized-box{background:#FBF8F2;border:1px solid var(--border);padding:10px 14px;font-size:11px;color:var(--gold);display:none}

/* SPECIALIST */
.specialist-block{background:linear-gradient(135deg,#FBF2F1,#FBF7F0);border:1px solid #E8C8C4;padding:20px;display:none}
.specialist-block.active{display:block}
.spec-header{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.spec-title{font-size:13px;font-weight:500;color:var(--danger)}
.spec-sub{font-size:11px;color:var(--muted);line-height:1.6;margin-bottom:14px}
.spec-actions{display:flex;gap:8px}
.spec-btn-primary{background:var(--danger);color:white;border:none;padding:11px 18px;font-family:'Jost',sans-serif;font-size:10px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;transition:opacity .2s;flex:1}
.spec-btn-primary:hover{opacity:.85}
.spec-btn-secondary{background:none;border:1px solid var(--border);padding:11px 18px;font-family:'Jost',sans-serif;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;color:var(--muted);transition:all .2s;flex:1}
.spec-btn-secondary:hover{border-color:var(--ink);color:var(--ink)}

/* SHOP */
.shop-section{background:var(--warm);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:100px 60px}
.shop-inner{max-width:1200px;margin:0 auto}
.shop-empty{font-size:14px;color:var(--muted);padding:48px 0;text-align:center}
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1px;background:var(--border);margin-top:48px}
.product-card{background:var(--ivory);padding:28px;transition:background .2s,transform .2s;cursor:pointer}
.product-card:hover{background:white;transform:translateY(-3px);box-shadow:0 8px 24px rgba(28,25,22,.07)}
.p-img{font-size:36px;margin-bottom:16px}
