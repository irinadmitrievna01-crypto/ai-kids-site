// JSON helpers
function isJSON(s){try{JSON.parse(s);return true;}catch(e){return false;}}
function fixJSON(s){
  s=s.replace(/,\s*"[^"]*"\s*:\s*[^,\}\]]*$/,'').replace(/,\s*"[^"]*"\s*$/,'').replace(/,\s*\{[^\}]*$/,'').trimEnd().replace(/,\s*$/,'');
  var op=(s.match(/\[/g)||[]).length-(s.match(/\]/g)||[]).length;
  var br=(s.match(/\{/g)||[]).length-(s.match(/\}/g)||[]).length;
  for(var i=0;i<op;i++)s+=']'; for(var i=0;i<br;i++)s+='}';
  return s;
}

// MAIN ANALYSIS
function runAnalysis(){
  var hasImg=images.some(function(x){return x!==null;});
  if(!tags.length&&!hasImg){alert('Добавьте продукты или фото');return;}

  var key=document.getElementById('apiKey').value.trim()||getKey();
  if(!key){
    // Use free tier
    if(!canFree()){openModal('paywallModal');return;}
  }

  var btn=document.getElementById('analyzeBtn'), sp=document.getElementById('spinner'), bt=document.getElementById('btnText');
  btn.disabled=true; sp.style.display='block'; bt.textContent='Анализируем…';
  document.getElementById('loadingOverlay').classList.add('active');

  var promise;

  if(key){
    // Direct API with user key
    var parts=[];
    images.forEach(function(img){
      if(img) parts.push({type:'image',source:{type:'base64',media_type:img.type,data:img.b64}});
    });
    if(tags.length||!parts.length) parts.push({type:'text',text:'Продукты'+(tags.length?': '+tags.join(', '):'')+'. Проанализируй совместимость, составь ритуал, рекомендации.'});
    else parts.push({type:'text',text:'Распознай косметику на фото, проанализируй совместимость, составь ритуал.'});

    var SYSTEM='Ты косметолог-эксперт. Отвечай ТОЛЬКО валидным JSON без markdown. Максимум: 4 конфликта, 5 шагов ритуал, 3 рекомендации, 3 совета.\nФормат: {"score":75,"scoreLabel":"Хорошо","summary":"Текст.","conflicts":[{"type":"danger","title":"Название","explanation":"Текст."}],"morningRoutine":[{"product":"Название","tip":"Текст."}],"eveningRoutine":[{"product":"Название","tip":"Текст."}],"tips":[{"emoji":"💧","text":"Текст."}],"recommendations":[{"brand":"Бренд","name":"Продукт","why":"Текст.","emoji":"🧴","price":"1500 ₽","shop":"goldapple.ru","sponsored":false}],"recognizedProducts":[]}';
    var BODY=JSON.stringify({model:'claude-sonnet-4-6',max_tokens:4096,system:SYSTEM,messages:[{role:'user',content:parts.length===1?parts[0].text:parts}]});

    promise=new Promise(function(resolve,reject){
      var xhr=new XMLHttpRequest();
      xhr.open('POST','https://api.anthropic.com/v1/messages',true);
      xhr.setRequestHeader('Content-Type','application/json');
      xhr.setRequestHeader('x-api-key',key);
      xhr.setRequestHeader('anthropic-version','2023-06-01');
      xhr.setRequestHeader('anthropic-dangerous-direct-browser-access','true');
      xhr.onload=function(){
        try{
          var d=JSON.parse(xhr.responseText);
          if(xhr.status!==200){reject(new Error(d&&d.error?d.error.message:'API ошибка '+xhr.status));return;}
          var raw=(d.content||[]).map(function(b){return b.text||'';}).join('');
          var clean=raw.replace(/^```[a-z]*\n?/i,'').replace(/```\s*$/i,'').trim();
          var m=clean.match(/\{[\s\S]*/);
          if(!m){reject(new Error('JSON не найден в ответе'));return;}
          var j=m[0].replace(/```[\s\S]*$/,'').trim();
          if(!isJSON(j)) j=fixJSON(j);
          resolve(JSON.parse(j));
        }catch(e){reject(new Error('Ошибка обработки ответа: '+e.message));}
      };
      xhr.onerror=function(){
        reject(new Error('Сетевая ошибка (status='+xhr.status+', readyState='+xhr.readyState+'). Safari из file:// блокирует внешние запросы — откройте файл через локальный сервер.'));
      };
      xhr.ontimeout=function(){reject(new Error('Превышено время ожидания.'));};
      xhr.timeout=60000;
      // Перехват Safari-специфичной ошибки до отправки
      try{
        xhr.send(BODY);
      }catch(sendErr){
        reject(new Error('xhr.send ошибка: '+sendErr.message+' | Браузер: '+navigator.userAgent.slice(0,80)));
      }
    });
  } else {
    // Free via backend
    var firstImg=images.find(function(x){return x!==null;});
    // iOS Safari fix: HEIC/HEIF не поддерживается API — используем jpeg
    var imgType=firstImg&&firstImg.type?firstImg.type:'image/jpeg';
    if(imgType==='image/heic'||imgType==='image/heif') imgType='image/jpeg';
    promise=fetch('/api/analyze',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        products:tags,
        imageBase64:firstImg?firstImg.b64:null,
        imageType:imgType
      })
    }).then(function(r){
      if(!r.ok){
        return r.json().catch(function(){return {error:'Ошибка сервера '+r.status};}).then(function(d){
          throw new Error(d.error||'Ошибка сервера '+r.status);
        });
      }
      return r.json();
    }).catch(function(e){
      // Если fetch совсем упал (сеть, CORS и т.д.)
      throw new Error(e.message||'Не удалось подключиться к серверу');
    });
  }

  promise.then(function(result){
    if(!key) setFree(getFree()+1);
    updateFreeUI();
    renderResults(result);
    renderRecommendations(result.recommendations||[]);
    confetti();
  })
  .catch(function(e){
    document.getElementById('resultPanel').innerHTML='<div class="err-box"><strong>Ошибка:</strong> '+esc(e.message)+'</div>';
  })
  .then(function(){resetBtn();},function(){resetBtn();});

  function resetBtn(){btn.disabled=false;sp.style.display='none';bt.textContent='Запустить анализ';document.getElementById('loadingOverlay').classList.remove('active');}
}

// Render results
function renderResults(r){
  var score=r.score||0;
  var color=score>=80?'var(--ok)':score>=60?'var(--warn)':'var(--danger)';
  var circ=2*Math.PI*50, off=circ-(score/100)*circ;

  var confHtml=(r.conflicts||[]).map(function(c){
    return '<div class="conflict-item '+(c.type||'ok')+'"><div class="c-title">'+esc(c.title)+'</div><div class="c-exp">'+esc(c.explanation)+'</div></div>';
  }).join('')||'<p style="font-size:12px;color:var(--ok);padding:4px 0">Конфликтов не обнаружено ✓</p>';

  function rHtml(items){
    return (items||[]).map(function(item,i){
      return '<div class="r-item"><div class="r-num">'+(i+1)+'</div><div><div class="r-prod">'+esc(item.product)+'</div><div class="r-tip">'+esc(item.tip)+'</div></div></div>';
    }).join('')||'<div style="font-size:11px;color:var(--muted)">—</div>';
  }

  var tipsHtml=(r.tips||[]).map(function(t){
    return '<div class="tip-item"><span style="flex-shrink:0">'+(t.emoji||'✦')+'</span><span>'+esc(t.text)+'</span></div>';
  }).join('');

  var rec=document.getElementById('recognizedBox');
  if(r.recognizedProducts&&r.recognizedProducts.length){
    rec.style.display='block';
    rec.textContent='Распознано с фото: '+r.recognizedProducts.join(', ');
    r.recognizedProducts.forEach(addTag);
  }

  // Shelf
  var allP=tags.concat(r.recognizedProducts||[]);
  var dNames=(r.conflicts||[]).filter(function(c){return c.type==='danger';}).map(function(c){return c.title.toLowerCase();});
  var wNames=(r.conflicts||[]).filter(function(c){return c.type==='warn';}).map(function(c){return c.title.toLowerCase();});
  var shelf=allP.map(function(name){
    var n=name.toLowerCase(), s='ok';
    dNames.forEach(function(d){if(d.indexOf(n)>-1||n.indexOf(d)>-1) s='danger';});
    wNames.forEach(function(w){if(w.indexOf(n)>-1||n.indexOf(w)>-1) s='warn';});
    return {name:name,status:s};
  });
  renderShelf(shelf);

  var hasProblems=(r.conflicts||[]).some(function(c){return c.type==='danger'||c.type==='warn';});
  var specBlock=hasProblems?'<div class="specialist-block active"><div class="spec-header"><span>🔴</span><span class="spec-title">Рекомендуем консультацию косметолога</span></div><div class="spec-sub">Найдены потенциально опасные комбинации. Специалист поможет скорректировать уход.</div><div class="spec-actions"><button class="spec-btn-primary" onclick="openModal(\'specModal\')">Записаться онлайн · 1500₽</button><button class="spec-btn-secondary" onclick="openModal(\'specModal\')">Загрузить фото кожи</button></div></div>':'';

  var rp=document.getElementById('resultPanel');
  rp.className='result-col success';
  rp.innerHTML=
    '<div class="score-block">'+
      '<div class="score-ring-wrap"><svg width="110" height="110" viewBox="0 0 110 110"><circle class="ring-bg" cx="55" cy="55" r="50"/><circle class="ring-fill" id="ringFill" cx="55" cy="55" r="50" stroke="'+color+'" stroke-dasharray="'+circ+'" stroke-dashoffset="'+circ+'"/></svg>'+
      '<div class="score-num" style="color:'+color+'">'+score+'</div></div>'+
      '<div class="score-lbl" style="color:'+color+'">'+esc(r.scoreLabel||'')+'</div>'+
      '<div class="score-summary">'+esc(r.summary||'')+'</div>'+
    '</div>'+
    specBlock+
    '<div class="result-block"><div class="block-title">Конфликты и синергии</div><div class="conflict-list">'+confHtml+'</div></div>'+
    '<div class="result-block"><div class="block-title">Ритуал ухода</div><div class="routine-cols"><div><div class="r-col-lbl">☀ Утро</div>'+rHtml(r.morningRoutine)+'</div><div><div class="r-col-lbl">◑ Вечер</div>'+rHtml(r.eveningRoutine)+'</div></div></div>'+
    (tipsHtml?'<div class="result-block"><div class="block-title">Советы</div><div class="tips-list">'+tipsHtml+'</div></div>':'')+
    '<div><div class="block-title">Поделиться</div><div class="share-row">'+
      '<button class="share-btn" onclick="copyShare('+score+',\''+esc(r.scoreLabel||'')+'\')">Скопировать результат</button>'+
      '<button class="share-btn" onclick="shareAppFn()">Поделиться сайтом</button>'+
    '</div></div>';

  setTimeout(function(){rp.className='result-col';},1600);
  requestAnimationFrame(function(){
    var ring=document.getElementById('ringFill');
    if(ring){ring.style.transition='stroke-dashoffset 1.4s cubic-bezier(.4,0,.2,1)';ring.style.strokeDashoffset=off;}
  });
  rp.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function renderRecommendations(recs){
  var pg=document.getElementById('productsGrid'), se=document.getElementById('shopEmpty');
  pg.innerHTML='';
  if(!recs||!recs.length){se.style.display='block';return;}
  se.style.display='none';
  recs.forEach(function(rec){
    var card=document.createElement('div'); card.className='product-card';
    var shop=(rec.shop||'').replace(/^https?:\/\//,'');
    card.innerHTML='<div class="p-img">'+(rec.emoji||'🧴')+'</div>'+
      (rec.sponsored?'<div class="sp-badge">Реклама</div>':'')+
      '<div class="p-brand">'+esc(rec.brand||'')+'</div>'+
      '<div class="p-name">'+esc(rec.name||'')+'</div>'+
      '<div class="p-why">'+esc(rec.why||'')+'</div>'+
      '<div class="p-footer"><div class="p-price">'+esc(rec.price||'—')+'</div>'+
      '<button class="buy-btn" onclick="openShop(\''+shop+'\',\''+esc((rec.brand||'')+' '+(rec.name||''))+'\')">Купить</button></div>';
    pg.appendChild(card);
  });
  document.getElementById('shopSection').scrollIntoView({behavior:'smooth'});
}

