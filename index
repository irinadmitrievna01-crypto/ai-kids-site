function getDayKey(day){
  var keys=[1,3,7,14,30], best=1;
  keys.forEach(function(k){if(k<=day) best=k;});
  return best;
}

function renderProtocol(){
  var panel=document.getElementById('protocolPanel');
  if(!selectedProc){panel.innerHTML='<div class="protocol-empty">Выберите процедуру и день</div>';return;}
  var data=PROTO[selectedProc][getDayKey(selectedDay)];
  if(!data){panel.innerHTML='<div class="protocol-empty">Нет данных</div>';return;}
  var names={rf:'РФ-лифтинг',laser:'Лазерная шлифовка',peel:'Химический пилинг',inject:'Инъекции',clean:'Чистка лица'};
  var html='<div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px">'+names[selectedProc]+' · день '+selectedDay+'</div>';
  if(data.can&&data.can.length){
    html+='<div class="proto-phase ok">✓ Можно сегодня</div><div class="protocol-list">';
    data.can.forEach(function(item){html+='<div class="proto-item can"><span style="flex-shrink:0">✅</span><span>'+esc(item)+'</span></div>';});
    html+='</div>';
  }
  if(data.cant&&data.cant.length){
    html+='<div class="proto-phase no">✗ Нельзя сегодня</div><div class="protocol-list">';
    data.cant.forEach(function(item){html+='<div class="proto-item cant"><span style="flex-shrink:0">❌</span><span>'+esc(item)+'</span></div>';});
    html+='</div>';
  }
  panel.innerHTML=html;
}

// Confetti
function confetti(){
  var colors=['#B8965A','#3A6E50','#9B3A2F','#D4AE78','#A0743A'];
  for(var i=0;i<18;i++){
    var d=document.createElement('div'); d.className='confetti-dot';
    d.style.cssText='left:'+Math.random()*100+'vw;top:15vh;background:'+colors[i%5]+';animation-delay:'+Math.random()*.4+'s;animation-duration:'+(0.9+Math.random()*.5)+'s';
    document.body.appendChild(d);
    setTimeout(function(dot){document.body.removeChild(dot);},1600,d);
  }
}

// Utils
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

window.openShop=function(shop,name){if(!shop)return;window.open('https://'+shop+'/search?q='+encodeURIComponent(name),'_blank');};

window.copyShare=function(score,label){
  var text='🌿 Проверила косметику на SkinSync!\n✦ Рейтинг: '+score+'/100 — '+label+'\nПроверь бесплатно: skin-sync-nu.vercel.app';
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(function(){alert('Скопировано! 📱');}).catch(function(){fallbackCopy(text);});}
  else fallbackCopy(text);
};
window.shareAppFn=function(){
  var url='https://skin-sync-nu.vercel.app';
  if(navigator.share) navigator.share({title:'SkinSync',text:'Проверила косметику с ИИ! ',url:url}).catch(function(){});
  else fallbackCopy('🌿 Проверь свою косметику с ИИ: '+url);
};
function fallbackCopy(text){
  var ta=document.createElement('textarea'); ta.value=text; ta.style.cssText='position:fixed;opacity:0';
  document.body.appendChild(ta); ta.focus(); ta.select();
  try{document.execCommand('copy');alert('Скопировано!');}catch(e){alert(text);}
  document.body.removeChild(ta);
}
})();
