    STATE.completedModules = JSON.parse(localStorage.getItem('ai-kids-modules') || '\{\}');\
    STATE.botName = localStorage.getItem('ai-kids-botname') || '\uc0\u1041 \u1080 \u1087 \u1080 \u1082 ';\
