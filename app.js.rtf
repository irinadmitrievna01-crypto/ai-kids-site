  \
  if (data.home === zone) \{\
    if (zoneEl) \{\
      zoneEl.textContent = data.emoji;\
      zoneEl.classList.add('filled');\
    \}\
    if (itemEl) itemEl.style.display = 'none';\
    if (feedback) \{\
      feedback.textContent = '\uc0\u9989  \u1055 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1086 ! \u1052 \u1086 \u1083 \u1086 \u1076 \u1077 \u1094 ! \u55356 \u57225 ';\
