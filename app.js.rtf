// Голосовой помощник
function initSpeechRecognition() {
  if (!('SpeechRecognition' in window || 'webkitSpeechRecognition' in window)) return;
  
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  STATE.recognition = new SR();
  STATE.recognition.lang = 'ru-RU';
  STATE.recognition.continuous = false;
  STATE.recognition.interimResults = false;
  
  STATE.recognition.onresult = (event) => {
    const said = event.results[0][0].transcript.toLowerCase().trim();
    const output = document.getElementById('voice-output');
    if (output) {
      output.innerHTML = `<strong>Ты сказал:</strong> "${said}"<br><br>`;
      processVoiceInput(said);
    }
  };
  
  STATE.recognition.onend = () => {
    STATE.isRecording = false;
    document.getElementById('mic-btn')?.classList.remove('recording');
    const status = document.getElementById('mic-status');
    if (status) status.textContent = 'Нажми, чтобы говорить';
  };
  
  STATE.recognition.onerror = () => {
    STATE.isRecording = false;
    document.getElementById('mic-btn')?.classList.remove('recording');
    const output = document.getElementById('voice-output');
    if (output) output.textContent = 'Не смог услышать... Попробуй ещё раз! 👂';
  };
}

function toggleVoice() {
  if (!STATE.recognition) {
    robotSay('Голос не поддерживается в этом браузере. Попробуй Chrome! 🌐');
    return;
  }
  
  if (STATE.isRecording) {
    STATE.recognition.stop();
  } else {
    STATE.recognition.start();
    STATE.isRecording = true;
    document.getElementById('mic-btn')?.classList.add('recording');
    const status = document.getElementById('mic-status');
    if (status) status.textContent = 'Слушаю... 🎤';
  }
  playClickSound();
}

function processVoiceInput(text) {
  let response = null;
  for (const [key, val] of Object.entries(ROBOT_GREETINGS)) {
    if (text.includes(key)) { response = val; break; }
  }
  if (!response) response = ROBOT_REPLIES[Math.floor(Math.random() * ROBOT_REPLIES.length)];
  
  const output = document.getElementById('voice-output');
  if (output) output.innerHTML += `<strong>🤖 Бипик:</strong> ${response}`;
  
  if ('speechSynthesis' in window) {
    const utt = new SpeechSynthesisUtterance(response.replace(/[^\w\s!?.,]/g, ''));
    utt.lang = 'ru-RU';
    utt.rate = 0.9;
    window.speechSynthesis.speak(utt);
  }
}

function robotSay(text) {
  const output = document.getElementById('voice-output');
  if (output) output.textContent = `🤖 Бипик: ${text}`;
  
  if ('speechSynthesis' in window) {
    const utt = new SpeechSynthesisUtterance(text.replace(/[^\w\s!?.,]/g, ''));
    utt.lang = 'ru-RU';
    window.speechSynthesis.speak(utt);
  }
  playClickSound();
}

function speakRandom() {
  const phrases = [
    "Ты знаешь, что роботы сделаны из металла и электричества? ⚡",
    "Бип-боп! Сегодня отличный день для изучения ИИ! 🤖",
    "Я думаю со скоростью миллион мыслей в секунду! 💭"
  ];
  robotSay(phrases[Math.floor(Math.random() * phrases.length)]);
}

