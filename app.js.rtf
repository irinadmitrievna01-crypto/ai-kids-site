function animateDrawing(type) \{\
  const sprite = document.getElementById('animated-sprite');\
  if (!sprite) return;\
  \
  if (STATE.animationInterval) \{\
    clearInterval(STATE.animationInterval);\
    STATE.animationInterval = null;\
  \}\
  \
  sprite.style.animation = 'none';\
  sprite.offsetHeight;\
  \
  switch(type) \{\
    case 'dance':\
      sprite.style.animation = 'dance 1s ease-in-out infinite';\
      break;\
    case 'jump':\
      sprite.style.animation = 'bounce 0.6s ease-in-out infinite';\
      break;\
    case 'walk':\
      let walkPos = 0;\
      STATE.animationInterval = setInterval(() => \{\
        walkPos = (walkPos + 10) % 200;\
        sprite.style.marginLeft = walkPos + 'px';\
        sprite.style.transform = walkPos % 20 < 10 ? 'scaleX(1)' : 'scaleX(-1)';\
      \}, 300);\
      break;\
    case 'spin':\
      sprite.style.animation = 'spin 1s linear infinite';\
      break;\
    case 'wiggle':\
      sprite.style.animation = 'wiggle 0.5s ease-in-out infinite';\
      break;\
  \}\
  \
  playClickSound();\
  \
  setTimeout(() => \{\
    if (STATE.animationInterval) \{\
      clearInterval(STATE.animationInterval);\
      STATE.animationInterval = null;\
    \}\
    sprite.style.animation = 'none';\
    sprite.style.marginLeft = '0';\
    sprite.style.transform = 'none';\
  \}, 5000);\
\}\
\
// Drag and Drop\
function initDragAndDrop() \{\
  const items = document.querySelectorAll('.drag-item');\
  items.forEach(item => \{\
    item.addEventListener('dragstart', e => \{\
      e.dataTransfer.setData('text/plain', item.dataset.animal);\
      item.classList.add('dragging');\
    \});\
    item.addEventListener('dragend', () => item.classList.remove('dragging'));\
    \
    // Touch\
    let isDragging = false;\
    item.addEventListener('touchstart', e => \{\
      isDragging = true;\
      item.style.opacity = '0.6';\
    \}, \{ passive: true \});\
    \
    item.addEventListener('touchmove', e => \{\
      if (!isDragging) return;\
      e.preventDefault();\
      const touch = e.touches[0];\
      item.style.position = 'fixed';\
      item.style.left = (touch.clientX - 25) + 'px';\
      item.style.top = (touch.clientY - 25) + 'px';\
      item.style.zIndex = '1000';\
    \}, \{ passive: false \});\
    \
    item.addEventListener('touchend', e => \{\
      isDragging = false;\
      item.style.opacity = '1';\
      item.style.position = '';\
      item.style.left = '';\
      item.style.top = '';\
      item.style.zIndex = '';\
      \
      const touch = e.changedTouches[0];\
      const elem = document.elementFromPoint(touch.clientX, touch.clientY);\
      const zone = elem?.closest('.drop-zone');\
      if (zone) handleDrop(null, zone.dataset.zone, item.dataset.animal);\
    \}, \{ passive: true \});\
  \});\
  \
  // Drop zones\
  document.querySelectorAll('.drop-zone').forEach(zone => \{\
    zone.addEventListener('dragover', e => \{\
      e.preventDefault();\
      zone.classList.add('highlight');\
    \});\
    zone.addEventListener('dragleave', () => zone.classList.remove('highlight'));\
    zone.addEventListener('drop', e => \{\
      e.preventDefault();\
      zone.classList.remove('highlight');\
      const animal = e.dataTransfer.getData('text/plain');\
      handleDrop(e, zone.dataset.zone, animal);\
    \});\
  \});\
\}\
\
function handleDrop(event, zone, animal) \{\
  const data = DRAG_DATA[animal];\
