function loadState() {
  try {
    STATE.stars = parseInt(localStorage.getItem('ai-kids-stars') || '0');
    STATE.completedModules = JSON.parse(localStorage.getItem('ai-kids-modules') || '{}');
    STATE.botName = localStorage.getItem('ai-kids-botname') || 'Бипик';
    STATE.botRules = JSON.parse(localStorage.getItem('ai-kids-botrules') || '[]');
  } catch(e) {
    console.log('LocalStorage not available');
  }
}

function saveState() {
  try {
    localStorage.setItem('ai-kids-stars', STATE.stars);
    localStorage.setItem('ai-kids-modules', JSON.stringify(STATE.completedModules));
    localStorage.setItem('ai-kids-botname', STATE.botName);
    localStorage.setItem('ai-kids-botrules', JSON.stringify(STATE.botRules));
  } catch(e) {
    console.log('LocalStorage not available');
  }
}

// Event Delegation
function initEventListeners() {
  // Навигация
  document.querySelectorAll('[data-page]').forEach(el => {
    el.addEventListener('click', () => goToPage(el.dataset.page));
  });
  
  document.querySelectorAll('[data-back]').forEach(el => {
    el.addEventListener('click', () => goToPage(el.dataset.back));
  });
  
  // Модалки
  document.getElementById('parent-btn')?.addEventListener('click', openParentModal);
  document.getElementById('close-parent-modal')?.addEventListener('click', closeParentModal);
  document.getElementById('close-star-modal')?.addEventListener('click', closeStarModal);
  
  document.querySelectorAll('.modal-overlay').forEach(m => {
    m.addEventListener('click', (e) => { if (e.target === m) m.classList.remove('open'); });
  });
  
  // Голосовой помощник
  document.getElementById('mic-btn')?.addEventListener('click', toggleVoice);
  document.getElementById('speak-random')?.addEventListener('click', speakRandom);
  
  document.querySelectorAll('.robot-say').forEach(btn => {
    btn.addEventListener('click', () => robotSay(btn.dataset.text));
  });
  
  // Рисовалка
  document.getElementById('clear-canvas')?.addEventListener('click', clearCanvas);
  document.getElementById('download-canvas')?.addEventListener('click', downloadCanvas);
  
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.filter));
  });
  
  document.querySelectorAll('.brush-dot').forEach(dot => {
    dot.addEventListener('click', () => setBrushSize(parseInt(dot.dataset.size), dot));
  });
  
  // Анимация
  document.querySelectorAll('.animate-btn').forEach(btn => {
    btn.addEventListener('click', () => animateDrawing(btn.dataset.anim));
  });
  
  // Перетаскивание
  document.getElementById('reset-drag')?.addEventListener('click', resetDragGame);
  
  // Сказки
  document.getElementById('generate-story')?.addEventListener('click', generateStory);
  document.getElementById('read-story')?.addEventListener('click', readStoryAloud);
  document.getElementById('download-story')?.addEventListener('click', downloadStory);
  
  // Игры
  document.getElementById('run-game')?.addEventListener('click', runGame);
  document.getElementById('clear-blocks')?.addEventListener('click', clearBlocks);
  document.getElementById('reset-game')?.addEventListener('click', resetGame);
  document.getElementById('export-game')?.addEventListener('click', exportGame);
  
  document.querySelectorAll('.code-block').forEach(block => {
    block.addEventListener('click', () => addBlock(block.dataset.block));
  });
  
  // Чат-бот
  document.getElementById('add-bot-rule')?.addEventListener('click', addBotRule);
  document.getElementById('send-chat')?.addEventListener('click', sendChat);
  document.getElementById('bot-name')?.addEventListener('input', updateBotName);
  document.getElementById('chat-input')?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendChat();
  });
  
  // Промпты
  document.getElementById('generate-prompt')?.addEventListener('click', generatePrompt);
  document.getElementById('copy-prompt')?.addEventListener('click', copyPrompt);
  
  // Языки
  document.querySelectorAll('.lang-tab').forEach(tab => {
    tab.addEventListener('click', () => switchLang(tab.dataset.lang));
  });
  
  document.querySelectorAll('.category-tab').forEach(tab => {
    tab.addEventListener('click', () => switchCategory(tab.closest('.lang-content').id.split('-')[1], tab.dataset.cat));
  });
  
  document.querySelectorAll('.speak-word').forEach(btn => {
    btn.addEventListener('click', () => speakWord(btn.dataset.lang));
  });
  
  document.querySelectorAll('.next-word').forEach(btn => {
    btn.addEventListener('click', () => nextWord(btn.dataset.lang));
  });
  
  // Звёзды
  document.querySelectorAll('.award-star').forEach(btn => {
    btn.addEventListener('click', () => awardStar(btn.dataset.module));
  });
  
  // Кнопки с анимацией
  document.querySelectorAll('.btn').forEach(btn => {
    btn.addEventListener('click', function() {
      this.classList.remove('bounce-anim');
      void this.offsetWidth;
      this.classList.add('bounce-anim');
      setTimeout(() => this.classList.remove('bounce-anim'), 500);
    });
  });
}

// Навигация
function goToPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById(`page-${page}`);
  if (target) {
    target.classList.add('active');
    window.scrollTo(0, 0);
    if (page === 'home') updateHomeProgress();
  }
}

// Звёзды
function awardStar(moduleName) {
  STATE.stars += 1;
  STATE.completedModules[moduleName] = (STATE.completedModules[moduleName] || 0) + 1;
  saveState();
  updateStarsDisplay();
  showStarModal(moduleName);
  playConfetti();
  playSuccessSound();
  updateHomeProgress();
}

function updateStarsDisplay() {
  const el = document.getElementById('stars-count');
  if (el) el.textContent = STATE.stars;
}

function showStarModal(moduleName) {
  const text = document.getElementById('star-modal-text');
  const total = document.getElementById('total-stars-display');
  if (text) text.textContent = `Задание "${moduleName}" выполнено! Продолжай в том же духе!`;
  if (total) total.textContent = `⭐ Всего звёзд: ${STATE.stars}`;
  document.getElementById('star-modal')?.classList.add('open');
}

function closeStarModal() {
  document.getElementById('star-modal')?.classList.remove('open');
}

function updateHomeProgress() {
  const list = document.getElementById('home-progress-list');
  if (!list) return;
  
  const modules = ['Рисунок', 'Сказка', 'Перетаскивание', 'Голос', 'Чат-бот', 'Промпт', 'Проект', 'Анимация', 'Английский', 'Китайский'];
  list.innerHTML = modules.map(m => {
    const done = STATE.completedModules[m] || 0;
    const pct = Math.min(100, done * 33);
    return `
      <div class="progress-item">
        <span class="progress-item-label">${m}</span>
        <div class="progress-item-bar">
          <div class="progress-bar-wrap">
            <div class="progress-bar-fill" style="width:${pct}%"></div>
          </div>
        </div>
        <span class="progress-item-pct">${pct}%</span>
      </div>
    `;
  }).join('');
}

// Конфетти и звуки
function playConfetti() {
  const container = document.getElementById('confetti-container');
  if (!container) return;
  
  const colors = ['#7C3AED','#F97316','#0D9488','#EC4899','#FBBF24','#60A5FA'];
  for (let i = 0; i < 50; i++) {
    const c = document.createElement('div');
    c.className = 'confetti-piece';
    c.style.cssText = `
      left: ${Math.random() * 100}vw;
      background: ${colors[Math.floor(Math.random() * colors.length)]};
      width: ${6 + Math.random() * 10}px;
      height: ${6 + Math.random() * 10}px;
      border-radius: ${Math.random() > 0.5 ? '50%' : '2px'};
      animation-duration: ${1.5 + Math.random() * 2.5}s;
      animation-delay: ${Math.random() * 0.5}s;
    `;
    container.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
}

function playSuccessSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [523, 659, 784, 1047].forEach((freq, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.frequency.value = freq;
      osc.type = 'sine';
      gain.gain.setValueAtTime(0.3, ctx.currentTime + i * 0.12);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.12 + 0.3);
      osc.start(ctx.currentTime + i * 0.12);
      osc.stop(ctx.currentTime + i * 0.12 + 0.3);
    });
  } catch(e) {}
}

function playClickSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.frequency.value = 800;
    osc.type = 'sine';
    gain.gain.setValueAtTime(0.15, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
    osc.start(ctx.currentTime);
    osc.stop(ctx.currentTime + 0.1);
  } catch(e) {}
}

function playErrorSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.frequency.value = 220;
    osc.type = 'sawtooth';
    gain.gain.setValueAtTime(0.2, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
    osc.start(ctx.currentTime);
    osc.stop(ctx.currentTime + 0.4);
  } catch(e) {}
}

