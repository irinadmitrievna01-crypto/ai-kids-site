  \
  grid.innerHTML = PROJECTS.map(p => `\
    <div class="project-card" onclick="openProject('$\{p.id\}')">\
      <span class="project-icon">$\{p.icon\}</span>\
      <h4>$\{p.title\}</h4>\
      <p>$\{p.desc\}</p>\
      <div style="font-size:0.8rem; color:var(--text-dim); margin-top:4px;">$\{p.difficulty\}</div>\
      <div class="project-stars">$\{p.stars\}</div>\
      $\{STATE.completedModules[`project-$\{p.id\}`] ? '<div style="color:#10B981; font-size:0.8rem; margin-top:4px;">\uc0\u9989  \u1042 \u1099 \u1087 \u1086 \u1083 \u1085 \u1077 \u1085 \u1086 !</div>' : ''\}\
    </div>\
  `).join('');\
\}\
\
function openProject(id) \{\
  const project = PROJECTS.find(p => p.id === id);\
  if (!project) return;\
  \
  alert(`$\{project.icon\} $\{project.title\}\\n\\n$\{project.steps.map((s, i) => `$\{i+1\}. $\{s.title\}: $\{s.text\}`).join('\\n\\n')\}`);\
  awardStar('\uc0\u1055 \u1088 \u1086 \u1077 \u1082 \u1090 ');\
\}\
\
// \uc0\u1071 \u1079 \u1099 \u1082 \u1080 \
function initLanguageGames() \{\
  updateWordCard('en');\
  updateWordCard('zh');\
  updateGameOptions('en');\
  updateGameOptions('zh');\
\}\
\
function switchLang(lang) \{\
  STATE.currentLang = lang;\
  document.querySelectorAll('.lang-tab').forEach(t => t.classList.remove('active'));\
  event.target.classList.add('active');\
  \
  document.querySelectorAll('.lang-content').forEach(c => c.classList.remove('active'));\
  document.getElementById(`lang-$\{lang\}`).classList.add('active');\
  \
  // Reset category\
  STATE.currentCategory = 'animals';\
  document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));\
  document.querySelector(`#lang-$\{lang\} .category-tab`).classList.add('active');\
  \
  updateWordCard(lang);\
  updateGameOptions(lang);\
\}\
\
function switchCategory(lang, cat) \{\
  STATE.currentCategory = cat;\
  STATE.wordIndices[lang] = 0;\
  \
  const container = document.getElementById(`lang-$\{lang\}`);\
  container.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));\
  event.target.classList.add('active');\
  \
  updateWordCard(lang);\
  updateGameOptions(lang);\
\}\
\
function updateWordCard(lang) \{\
  const data = LANG_DATA[lang][STATE.currentCategory];\
  const idx = STATE.wordIndices[lang] % data.length;\
  const word = data[idx];\
  \
  document.getElementById(`$\{lang\}-word`).textContent = word.word;\
  document.getElementById(`$\{lang\}-transcription`).textContent = word.transcription;\
  document.getElementById(`$\{lang\}-translation`).textContent = word.translation;\
\}\
\
function nextWord(lang) \{\
  STATE.wordIndices[lang]++;\
  updateWordCard(lang);\
  playClickSound();\
\}\
\
function speakWord(lang) \{\
  const data = LANG_DATA[lang][STATE.currentCategory];\
  const idx = STATE.wordIndices[lang] % data.length;\
  const word = data[idx];\
  \
  if ('speechSynthesis' in window) \{\
    const utt = new SpeechSynthesisUtterance(word.word);\
    utt.lang = lang === 'zh' ? 'zh-CN' : 'en-US';\
    utt.rate = 0.8;\
    window.speechSynthesis.speak(utt);\
  \}\
\}\
\
function updateGameOptions(lang) \{\
  const data = LANG_DATA[lang][STATE.currentCategory];\
  const idx = STATE.wordIndices[lang] % data.length;\
  const correct = data[idx];\
  \
  // \uc0\u1055 \u1086 \u1083 \u1091 \u1095 \u1072 \u1077 \u1084  2 \u1085 \u1077 \u1087 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1099 \u1093  \u1086 \u1090 \u1074 \u1077 \u1090 \u1072 \
  const wrong = data.filter((_, i) => i !== idx).sort(() => Math.random() - 0.5).slice(0, 2);\
  const options = [correct, ...wrong].sort(() => Math.random() - 0.5);\
  \
  const container = document.getElementById(`$\{lang\}-game-options`);\
  container.innerHTML = options.map(opt => \
    `<button class="btn btn-sm" onclick="checkAnswer('$\{lang\}', '$\{opt.translation\}')">$\{opt.translation\}</button>`\
  ).join('');\
  \
  document.getElementById(`$\{lang\}-game-word`).textContent = correct.word;\
  document.getElementById(`$\{lang\}-game-result`).textContent = '';\
\}\
\
function checkAnswer(lang, answer) \{\
  const data = LANG_DATA[lang][STATE.currentCategory];\
  const idx = STATE.wordIndices[lang] % data.length;\
  const correct = data[idx];\
  \
  const resultEl = document.getElementById(`$\{lang\}-game-result`);\
  \
  if (answer === correct.translation) \{\
    resultEl.textContent = '\uc0\u9989  \u1055 \u1088 \u1072 \u1074 \u1080 \u1083 \u1100 \u1085 \u1086 ! \u1052 \u1086 \u1083 \u1086 \u1076 \u1077 \u1094 !';\
    resultEl.style.color = '#10B981';\
    playSuccessSound();\
    awardStar(lang === 'en' ? '\uc0\u1040 \u1085 \u1075 \u1083 \u1080 \u1081 \u1089 \u1082 \u1080 \u1081 ' : '\u1050 \u1080 \u1090 \u1072 \u1081 \u1089 \u1082 \u1080 \u1081 ');\
    setTimeout(() => \{\
      nextWord(lang);\
      updateGameOptions(lang);\
    \}, 1500);\
  \} else \{\
    resultEl.textContent = '\uc0\u10060  \u1055 \u1086 \u1087 \u1088 \u1086 \u1073 \u1091 \u1081  \u1077 \u1097 \u1105  \u1088 \u1072 \u1079 !';\
    resultEl.style.color = '#F97316';\
    playErrorSound();\
  \}\
\}\
\
// \uc0\u1050 \u1085 \u1086 \u1087 \u1082 \u1080  \u1089  \u1072 \u1085 \u1080 \u1084 \u1072 \u1094 \u1080 \u1077 \u1081 \
document.querySelectorAll('.btn').forEach(btn => \{\
  btn.addEventListener('click', function() \{\
    this.classList.remove('bounce-anim');\
    void this.offsetWidth;\
    this.classList.add('bounce-anim');\
    setTimeout(() => this.classList.remove('bounce-anim'), 500);\
  \});\
\});\
\
